<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drop">
        <activity
            android:name=".link.OpenLinkConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".calendar.CalendarConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".contact.ContactConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".email.EmailConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".maps.MapConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".pdf.PdfImportActivity"
            android:exported="false" />
        <activity
            android:name=".timetable.TimetableReviewActivity"
            android:exported="false" />
        <activity
            android:name=".reminder.ReminderActivity"
            android:exported="false" />
        <activity
            android:name=".share.SharedStreamActivity"
            android:exported="true">
            <intent-filter android:label="Drop">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Drop">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Drop">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
